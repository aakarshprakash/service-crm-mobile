# Address of the Servon API (no trailing slash, no /api/v1).
# On a phone during development use your computer's LAN IP, and start the API with
#   php artisan serve --host=0.0.0.0 --port=8000
# Technicians can also change it on the sign-in screen ("Server").
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
